# ======================================
# CRYPTO TRADING PLATFORM - ENVIRONMENT
# ======================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control!

# ==================
# DATABASE SETTINGS
# ==================
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=trading_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ==================
# REDIS SETTINGS
# ==================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==================
# BINANCE API
# ==================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# IMPORTANT: Use testnet for testing! Set to false only for live trading
BINANCE_TESTNET=true

# ==================
# TELEGRAM BOT
# ==================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your Telegram ID from @userinfobot
# For multiple users: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=123456789

# Telegram settings
TELEGRAM_REQUIRE_AUTH=true
TELEGRAM_ENABLE_NOTIFICATIONS=true
TELEGRAM_LOG_LEVEL=INFO

# ==================
# APPLICATION
# ==================
APP_NAME=Crypto Trading Platform
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Secret key for JWT (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_random_secret_key_min_32_characters

# ==================
# PORTS
# ==================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ==================
# API URLS
# ==================
BACKEND_API_URL=http://backend:8000
VITE_API_URL=http://localhost:8000

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==================
# TRADING SETTINGS
# ==================
DEFAULT_INITIAL_CAPITAL=10000
DEFAULT_LEVERAGE=1
MAX_POSITION_SIZE_USDT=1000
MAX_DAILY_LOSS_USDT=100

# ==================
# SAFETY LIMITS
# ==================
MAX_POSITION_SIZE_USD=1000
MAX_OPEN_POSITIONS=3
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS_PERCENT=5.0
MIN_CAPITAL_USD=100
MAX_TOTAL_LOSS_PERCENT=20.0

# ==================
# CELERY SETTINGS
# ==================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==================
# LOGGING
# ==================
LOG_LEVEL=INFO

# ==================
# NOTES
# ==================
# 1. Never commit .env with real credentials
# 2. Use strong passwords in production
# 3. Set BINANCE_TESTNET=false only when ready for live trading
# 4. Generate strong SECRET_KEY
# 5. Get Telegram bot token from @BotFather
# 6. Get your Telegram ID from @userinfobot
# 7. Enable IP whitelist on Binance
# 8. Restrict API key permissions (disable withdrawals)
